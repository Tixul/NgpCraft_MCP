# NGPCraft Toolchain — Linker script NGPC Color
# Syntaxe : t900ld.py

memory {
    ram : org=0x004000, len=0x2C00
    rom : org=0x200040, len=0x1FFFC0   ; starts at 0x200040 (romtool prepends 64-byte header)
}

sections {
    far_area    > ram  { *(f_area) }
    far_startup > rom  { *(f_header) }
    far_const   > rom  { *(f_const) }
    far_code    > rom  { *(f_code) }
    dma_prog    > rom  { *(dma_prog) }
    far_alias   > rom  { *(ALIAS) }
    far_flash   > rom  { *(FLASH) }
    far_data    > rom  addr=far_area_end  { *(f_data) }
}

stack_top = 0x006000
